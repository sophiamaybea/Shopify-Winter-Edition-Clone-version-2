{
  "name": "CreativeAsset",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "conversation_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "image",
        "video",
        "gif",
        "audio",
        "rive",
        "svg",
        "model3d",
        "shader",
        "texture",
        "other"
      ]
    },
    "url": {
      "type": "string"
    },
    "mime_type": {
      "type": "string"
    },
    "size": {
      "type": "integer"
    },
    "width": {
      "type": "integer"
    },
    "height": {
      "type": "integer"
    },
    "duration": {
      "type": "number"
    },
    "prompt": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "staged",
        "approved",
        "applied",
        "rejected"
      ],
      "default": "staged",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "metadata": {
      "type": "object"
    },
    "interaction_config": {
      "type": "object"
    },
    "repo_path": {
      "type": "string"
    },
    "failure_code": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "owner_user_id",
    "conversation_id",
    "name",
    "kind",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}