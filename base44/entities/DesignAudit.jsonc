{
  "name": "DesignAudit",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "draft_id": {
      "type": "string"
    },
    "conversation_id": {
      "type": "string"
    },
    "event": {
      "type": "string",
      "enum": [
        "draft_created",
        "draft_previewed",
        "draft_rejected",
        "apply_requested",
        "apply_succeeded",
        "apply_failed",
        "asset_generated",
        "asset_approved",
        "asset_rejected",
        "stale_draft_detected",
        "revert_staged"
      ]
    },
    "base_commit": {
      "type": "string"
    },
    "applied_commit": {
      "type": "string"
    },
    "file_count": {
      "type": "integer"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "user_id",
    "event"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": false,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}